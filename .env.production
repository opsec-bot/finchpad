# Build-time PUBLIC frontend config, baked into web/dist by `vite build` (production mode).
# Everything here ships in the browser bundle, so it must contain NO secrets — only public
# values: chain id, public RPC, deployed contract addresses, and the public Privy app id.
# Vite loads this via envDir=".." (web/vite.config). The gitignored root .env (secrets) is
# NOT present in the Docker build, so this file is the sole source of VITE_* at build time.
VITE_CHAIN_ID=4663
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_FINCH_FACTORY=0x499A91F0FD04843f11700067D973D6117d224931
VITE_FINCH_LOCKER=0x9650049064fb049eb40707FA94751C5BaC0043A9
VITE_FINCH_REGISTRY=0xcD0993812aa63da0FaA44cCA87a78AD8f8F223A6
VITE_FINCH_FEATURE_BOOST=0x1f528017dbD7D92C50c374e0BA087a3643BdcBea
VITE_PRIVY_APP_ID=cmrvgn4t400am0cl7rl5l6514
