# Foundry build artifacts (always regenerable)
cache/
out/

# Local/dry-run deployment artifacts
broadcast/*/31337/
broadcast/**/dry-run/

.env

# NOTE: lib/ is intentionally committed (vendored deps, not submodules) so the exact
# OpenZeppelin 5.6.1 / forge-std versions are pinned for reproducible audit builds.
#
# ...but NOT the vendored libs' own npm dev toolchains. forge compiles only the .sol
# sources; these package.json/lockfiles are never installed or run by finchpad, yet
# Dependabot scans them and reports ~49 alerts from OZ's Hardhat/eslint/solhint stack.
# Keep them out so `forge update` can't reintroduce that noise.
lib/**/package.json
lib/**/package-lock.json

# Local fork seed artifacts (anvil runs as chain 4663, so the 31337 rule misses them)
broadcast/SeedLocal.s.sol/
