{
  "name": "finchpad",
  "version": "0.0.1",
  "description": "A token launchpad on Robinhood Chain — pons-style V3 launches with a fee-rights registry (CTO, GitHub claims, redirects, burns).",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "api": "node --env-file=.env src/backend/api.js",
    "index:backfill": "node --env-file=.env src/indexer/backfill.js",
    "index:swaps": "node --env-file=.env src/indexer/swaps.js",
    "verify:reference": "node --env-file=.env src/indexer/verifyReference.js"
  },
  "keywords": ["launchpad", "robinhood-chain", "uniswap-v3", "evm", "defi"],
  "license": "MIT",
  "dependencies": {
    "viem": "^2.21.0"
  }
}
