# finchpad configuration. Copy to .env and fill in what you need:
#
#   cp .env.example .env
#
# .env is gitignored. Everything here is read by three consumers:
#   - the backend/indexer (node, via --env-file=.env)
#   - the Foundry scripts (forge script reads the process environment)
#   - the frontend build (vite, but ONLY the VITE_-prefixed vars below)
#
# ─────────────────────────────────────────────────────────────────────────────
#  RULE: anything named VITE_* is PUBLIC.
#  Vite inlines those values into the JavaScript bundle every visitor downloads.
#  Never prefix a secret with VITE_. Everything without the prefix stays server-side.
# ─────────────────────────────────────────────────────────────────────────────


# ── RPC ──────────────────────────────────────────────────────────────────────
# Reads/blocks go through Alchemy; log scanning goes through the public RPC, because
# Alchemy's free tier caps eth_getLogs at 10 blocks while the public RPC serves 500+.
# See src/lib/chain.js. Both are optional and fall back to the public RPC.
ALCHEMY_RH_MAINNET=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
FINCHPAD_RPC_URL=
FINCHPAD_LOGS_RPC_URL=
# Never scan below this block (avoids crossing an anvil fork boundary, and avoids
# pointlessly scanning before the factory existed).
FINCHPAD_MIN_BLOCK=


# ── Backend API ──────────────────────────────────────────────────────────────
PORT=8787
# Which factory the read API indexes. Defaults to the live pons factory so the API
# returns real data before finchpad is deployed.
FINCH_FACTORY=
FINCH_REGISTRY=
FINCH_FEATURE_BOOST=
FINCH_CHAIN_ID=4663


# ── GitHub fee claims ────────────────────────────────────────────────────────
# OAuth app credentials. THE SECRET IS SERVER-ONLY — it must never reach the browser.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8787/auth/github/callback
# Leave empty for public repos and user claims. Set to "repo" only if claims on PRIVATE
# repos must work — it grants broad access, so it is a poor default to ask users for.
GITHUB_OAUTH_SCOPE=
# EIP-712 signer for GitHub claims. In production this belongs in an HSM/KMS on a host
# isolated from the public API, NOT here. Unset, the claim flow still verifies identity
# and returns signed:false.
FINCH_CLAIM_SIGNER_KEY=


# ── Deployment (contracts/script/Deploy.s.sol) ───────────────────────────────
# Preferred path is a Ledger: set FINCH_DEPLOYER and run forge script with --ledger,
# so no private key ever exists in plaintext. PRIVATE_KEY is for local/testnet only.
FINCH_DEPLOYER=
FINCH_ADMIN=
PRIVATE_KEY=
# Chain periphery (mainnet 4663 values shown in docs/robinhood-chain-reference.md)
FINCH_POSITION_MANAGER=0x73991a25C818Bf1f1128dEAaB1492D45638DE0D3
FINCH_SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
FINCH_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Fee recipients
FINCH_FEE_RECIPIENT=
FINCH_PROTOCOL_RECIPIENT=
FINCH_GITHUB_SIGNER=
# Economics — all IMMUTABLE constructor args. Retuning any of them means deploying a new
# factory/locker set, so decide before the deploy that takes real liquidity.
FINCH_PROTOCOL_BPS=2000
FINCH_REFERRAL_BPS=1000
FINCH_GRAD_BONUS_BPS=500
FINCH_GRAD_FEE_THRESHOLD=250000000000000000
FINCH_FEATURE_PRICE=10000000000000000
FINCH_BOOST_PRICE=50000000000000000


# ── Frontend (PUBLIC — inlined into the browser bundle) ──────────────────────
# Privy app ID. Public by design. The Privy app SECRET is backend-only and finchpad does
# not use it anywhere — do not add it here.
VITE_PRIVY_APP_ID=
# Chain id the browser expects. Leave unset for production (4663). For a LOCAL FORK set this
# and FORK_CHAIN_ID to the same non-4663 value (31337 is conventional): MetaMask has a
# built-in entry for 4663 pinned to the public RPC, so a fork on 4663 shows a 0 balance in
# the wallet no matter which RPC you configure.
VITE_CHAIN_ID=
# FORK_CHAIN_ID is read by scripts/dev-fork.mjs and must match VITE_CHAIN_ID.
FORK_CHAIN_ID=
# Chain RPC the browser talks to. Defaults to the public Robinhood Chain RPC.
# For the local anvil fork: http://localhost:8545
VITE_RPC_URL=
# finchpad deployment. Write actions stay disabled in the UI until VITE_FINCH_FACTORY is set,
# so nothing is sent into the void before the contracts exist.
VITE_FINCH_FACTORY=
VITE_FINCH_LOCKER=
VITE_FINCH_REGISTRY=
VITE_FINCH_FEATURE_BOOST=
