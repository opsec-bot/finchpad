# Privy app ID. PUBLIC by design — it ships in the browser bundle.
# The Privy app SECRET is backend-only and finchpad does not use it anywhere; do not add it.
VITE_PRIVY_APP_ID=

# Chain RPC. Defaults to the public Robinhood Chain RPC.
# For the local anvil fork: http://localhost:8545
VITE_RPC_URL=

# finchpad deployment. Unset until the contracts are deployed; write actions stay disabled
# until VITE_FINCH_FACTORY is present.
VITE_FINCH_FACTORY=
VITE_FINCH_LOCKER=
VITE_FINCH_REGISTRY=
VITE_FINCH_FEATURE_BOOST=
